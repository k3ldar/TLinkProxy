@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Dashboard</h1>
    <span id="lastUpdated" class="text-muted small"></span>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="mb-0">Context optimizer</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Period</th>
                            <th class="text-end">Tokens processed</th>
                            <th class="text-end">Tokens saved</th>
                            <th class="text-end">API calls</th>
                        </tr>
                    </thead>
                    <tbody id="tokenPeriodRows">
                        <tr>
                            <td colspan="4" class="text-center text-muted">Loading&hellip;</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="mb-0">Tools called</h5>
            </div>
            <div class="card-body">
                <p id="totalToolCalls" class="card-text fs-4 mb-0">&mdash;</p>
                <small class="text-muted">across all sessions</small>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Host diagnostics</h5>
        <span id="diagnosticsInterval" class="text-muted small"></span>
    </div>
    <div class="card-body">
        <div class="row g-3" id="hostDiagnostics">
            <div class="col-12 text-center text-muted">Loading&hellip;</div>
        </div>
        <hr />
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="mb-0">Memory history</h6>
            <span id="memoryHistoryInfo" class="text-muted small"></span>
        </div>
        <div id="memoryLegend" class="d-flex flex-wrap gap-3 small mb-2"></div>
        <div id="memoryChart" class="text-muted small">Collecting samples&hellip;</div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead class="table-light">
            <tr>
                <th>Alias</th>
                <th>Kind</th>
                <th>Model</th>
                <th>State</th>
                <th class="text-center">In-flight</th>
                <th class="text-center">Queued</th>
                <th>Goes inactive</th>
            </tr>
        </thead>
        <tbody id="modelRows">
            <tr>
                <td colspan="7" class="text-center text-muted">Loading&hellip;</td>
            </tr>
        </tbody>
    </table>
</div>

<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Most popular tools</h5>
    </div>
    <div class="card-body" id="toolUsage">
        <p class="text-muted mb-0">No tool calls recorded yet.</p>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const rows = document.getElementById('modelRows');
            const lastUpdated = document.getElementById('lastUpdated');
            const tokenPeriodRows = document.getElementById('tokenPeriodRows');
            const totalToolCalls = document.getElementById('totalToolCalls');
            const toolUsage = document.getElementById('toolUsage');
            const hostDiagnostics = document.getElementById('hostDiagnostics');
            const diagnosticsInterval = document.getElementById('diagnosticsInterval');
            const memoryChart = document.getElementById('memoryChart');
            const memoryLegend = document.getElementById('memoryLegend');
            const memoryHistoryInfo = document.getElementById('memoryHistoryInfo');
            let lastHistorySample = null;
            let historyRequestInFlight = false;

            const memorySeries = [
                { key: 'managedHeapBytes', label: 'Managed heap', color: '#0d6efd' },
                { key: 'gcCommittedBytes', label: 'GC committed', color: '#6f42c1' },
                { key: 'workingSetBytes', label: 'Working set', color: '#198754' },
                { key: 'privateMemoryBytes', label: 'Private memory', color: '#fd7e14' }
            ];

            function formatNumber(value) {
                if (value == null || isNaN(value)) {
                    return '&mdash;';
                }

                return new Intl.NumberFormat().format(value);
            }

            function formatBytes(value) {
                if (value == null || isNaN(value)) {
                    return '';
                }

                if (value < 1024) {
                    return value + ' B';
                }

                if (value < 1024 * 1024) {
                    return (value / 1024).toFixed(1) + ' KB';
                }

                if (value < 1024 * 1024 * 1024) {
                    return (value / 1024 / 1024).toFixed(1) + ' MB';
                }

                return (value / 1024 / 1024 / 1024).toFixed(1) + ' GB';
            }

            function stateBadge(m) {
                if (!m.enabled) {
                    return '<span class="badge bg-secondary">Disabled</span>';
                }

                if (!m.healthy) {
                    return '<span class="badge bg-danger">Unhealthy</span>';
                }

                if (m.isOnDemand && !m.isRunning) {
                    return '<span class="badge bg-warning text-dark">Idle</span>';
                }

                if (m.inFlight > 0) {
                    return '<span class="badge bg-primary">Processing</span>';
                }

                return '<span class="badge bg-success">Healthy</span>';
            }

            function inactiveText(m) {
                if (!m.enabled) {
                    return '<span class="text-muted">&mdash;</span>';
                }

                if (!m.isOnDemand) {
                    return '<span class="text-muted">Always on</span>';
                }

                if (!m.isRunning) {
                    return '<span class="text-muted">Stopped</span>';
                }

                if (!m.inactiveAtUtc) {
                    return '<span class="text-muted">&mdash;</span>';
                }

                return '<span data-countdown="' + m.inactiveAtUtc + '"></span>';
            }

            function escapeHtml(value) {
                if (value == null) {
                    return '';
                }

                const div = document.createElement('div');
                div.textContent = String(value);
                return div.innerHTML;
            }

            function refresh() {
                fetch('/home/status')
                    .then(response => response.json())
                    .then(data => {
                        let html = '';

                        if (!data.models || data.models.length === 0) {
                            html = '<tr><td colspan="7" class="text-center text-muted">No models configured</td></tr>';
                        } else {
                            data.models.forEach(m => {
                                html += '<tr>' +
                                    '<td><strong>' + escapeHtml(m.alias) + '</strong></td>' +
                                    '<td>' + escapeHtml(m.kind) + '</td>' +
                                    '<td>' + escapeHtml(m.model) + '</td>' +
                                    '<td>' + stateBadge(m) + '</td>' +
                                    '<td class="text-center">' + m.inFlight + ' / ' + m.concurrencyLimit + '</td>' +
                                    '<td class="text-center">' + m.queueDepth + (m.maxQueueDepth > 0 ? ' / ' + m.maxQueueDepth : '') + '</td>' +
                                    '<td>' + inactiveText(m) + '</td>' +
                                    '</tr>';
                            });
                        }

                        rows.innerHTML = html;
                        updateCountdowns();

                        renderOptimizerStats(data.optimizer);
                        renderDiagnostics(data.diagnostics);
                        refreshMemoryHistory(data.diagnostics);

                        if (data.generatedAtUtc) {
                            lastUpdated.textContent = 'Updated ' + new Date(data.generatedAtUtc).toLocaleTimeString();
                        }
                    })
                    .catch(() => {
                        rows.innerHTML = '<tr><td colspan="7" class="text-center text-danger">Failed to load status</td></tr>';
                    });
            }

            function renderOptimizerStats(optimizer) {
                if (!optimizer) {
                    return;
                }

                const periods = [
                    { label: 'Today', data: optimizer.today },
                    { label: 'This month', data: optimizer.thisMonth },
                    { label: 'Overall', data: optimizer.lifetime }
                ];

                let html = '';

                periods.forEach(period => {
                    const data = period.data || {};
                    html += '<tr>' +
                        '<td>' + escapeHtml(period.label) + '</td>' +
                        '<td class="text-end">' + formatNumber(data.tokensProcessed) + ' <small class="text-muted">' + formatBytes(data.bytesProcessed) + '</small></td>' +
                        '<td class="text-end">' + formatNumber(data.tokensSaved) + ' <small class="text-muted">' + formatBytes(data.tokensSaved) + '</small></td>' +
                        '<td class="text-end">' + formatNumber(data.apiCalls) + '</td>' +
                        '</tr>';
                });

                tokenPeriodRows.innerHTML = html;

                const tools = optimizer.toolsCalled || [];
                totalToolCalls.innerHTML = formatNumber(tools.reduce((sum, t) => sum + (t.count || 0), 0));

                if (tools.length === 0) {
                    toolUsage.innerHTML = '<p class="text-muted mb-0">No tool calls recorded yet.</p>';
                    return;
                }

                const maxCount = tools[0].count || 1;
                let toolHtml = '';

                tools.forEach(t => {
                    const width = Math.max(0, Math.round((t.count / maxCount) * 100));
                    toolHtml += '<div class="mb-2">' +
                        '<div class="d-flex justify-content-between">' +
                        '<span>' + escapeHtml(t.name) + '</span>' +
                        '<span class="text-muted">' + formatNumber(t.count) + '</span>' +
                        '</div>' +
                        '<div class="progress" style="height: 6px;">' +
                        '<div class="progress-bar" role="progressbar" style="width: ' + width + '%"></div>' +
                        '</div>' +
                        '</div>';
                });

                toolUsage.innerHTML = toolHtml;
            }

            function renderDiagnostics(d) {
                if (diagnosticsInterval) {
                    diagnosticsInterval.textContent = d && d.intervalSeconds ? 'Sampled every ' + d.intervalSeconds + 's' : '';
                }

                if (!d) {
                    hostDiagnostics.innerHTML = '<div class="col-12 text-center text-muted">No diagnostics available</div>';
                    return;
                }

                const stats = [
                    { label: 'Managed heap', value: formatBytes(d.managedHeapBytes) },
                    { label: 'GC committed', value: formatBytes(d.gcCommittedBytes) },
                    { label: 'Allocated (total)', value: formatBytes(d.totalAllocatedBytes) },
                    { label: 'Working set', value: formatBytes(d.workingSetBytes) },
                    { label: 'Private memory', value: formatBytes(d.privateMemoryBytes) },
                    { label: 'Thread pool threads', value: formatNumber(d.threadPoolThreads) },
                    { label: 'Pending work items', value: formatNumber(d.pendingWorkItems) },
                    { label: 'Completed work items', value: formatNumber(d.completedWorkItems) }
                ];

                let html = '';

                stats.forEach(s => {
                    html += '<div class="col-6 col-md-3">' +
                        '<div class="border rounded p-2 h-100">' +
                        '<div class="text-muted small">' + escapeHtml(s.label) + '</div>' +
                        '<div class="fs-5">' + s.value + '</div>' +
                        '</div>' +
                        '</div>';
                });

                const processes = d.processes || [];

                if (processes.length === 0) {
                    html += '<div class="col-12 text-muted small">No managed child processes running.</div>';
                } else {
                    html += '<div class="col-12"><table class="table table-sm table-striped mb-0">' +
                        '<thead class="table-light"><tr><th>Process</th><th class="text-end">PID</th>' +
                        '<th class="text-end">Working set</th><th class="text-end">Private memory</th></tr></thead>' +
                        '<tbody>';

                    processes.forEach(p => {
                        html += '<tr>' +
                            '<td><strong>' + escapeHtml(p.alias) + '</strong></td>' +
                            '<td class="text-end">' + formatNumber(p.processId) + '</td>' +
                            '<td class="text-end">' + formatBytes(p.workingSetBytes) + '</td>' +
                            '<td class="text-end">' + formatBytes(p.privateMemoryBytes) + '</td>' +
                            '</tr>';
                    });

                    html += '</tbody></table></div>';
                }

                hostDiagnostics.innerHTML = html;
            }

            function refreshMemoryHistory(d) {
                if (!d || !d.sampledAtUtc || d.sampledAtUtc === lastHistorySample || historyRequestInFlight) {
                    return;
                }

                historyRequestInFlight = true;

                fetch('/home/diagnostics/history', { cache: 'no-store' })
                    .then(response => response.json())
                    .then(history => {
                        lastHistorySample = d.sampledAtUtc;
                        renderMemoryChart(history);
                    })
                    .catch(() => { })
                    .finally(() => { historyRequestInFlight = false; });
            }

            function niceMax(value) {
                const magnitude = Math.pow(10, Math.floor(Math.log10(value)));

                for (const step of [1, 2, 5, 10]) {
                    if (value <= step * magnitude) {
                        return step * magnitude;
                    }
                }

                return 10 * magnitude;
            }

            function renderMemoryChart(history) {
                const samples = (history && history.samples) || [];

                memoryLegend.innerHTML = memorySeries.map(s =>
                    '<span><span style="display:inline-block;width:12px;height:12px;border-radius:2px;margin-right:4px;background:' + s.color + '"></span>' + escapeHtml(s.label) + '</span>').join('');

                if (samples.length < 2) {
                    memoryChart.textContent = 'Collecting samples\u2026';
                    memoryHistoryInfo.textContent = '';
                    return;
                }

                memoryHistoryInfo.textContent = samples.length + ' samples, every ' + history.intervalSeconds + 's';

                const width = 900, height = 240;
                const margin = { left: 70, right: 12, top: 10, bottom: 24 };
                const plotWidth = width - margin.left - margin.right;
                const plotHeight = height - margin.top - margin.bottom;

                let max = 0;
                samples.forEach(sample => memorySeries.forEach(s => { max = Math.max(max, sample[s.key] || 0); }));
                max = niceMax(Math.max(max, 1));

                const x = i => margin.left + (i / (samples.length - 1)) * plotWidth;
                const y = v => margin.top + plotHeight - ((v || 0) / max) * plotHeight;

                let svg = '<svg viewBox="0 0 ' + width + ' ' + height + '" width="100%" style="max-height:260px" role="img" aria-label="Memory history">';

                for (let tick = 0; tick <= 4; tick++) {
                    const value = (max / 4) * tick;
                    const ty = y(value);
                    svg += '<line x1="' + margin.left + '" x2="' + (width - margin.right) + '" y1="' + ty + '" y2="' + ty + '" stroke="#dee2e6" stroke-width="1" />' +
                        '<text x="' + (margin.left - 6) + '" y="' + (ty + 4) + '" text-anchor="end" font-size="11" fill="#6c757d">' + escapeHtml(formatBytes(value)) + '</text>';
                }

                const first = new Date(samples[0].sampledAtUtc).toLocaleTimeString();
                const last = new Date(samples[samples.length - 1].sampledAtUtc).toLocaleTimeString();
                svg += '<text x="' + margin.left + '" y="' + (height - 6) + '" font-size="11" fill="#6c757d">' + escapeHtml(first) + '</text>' +
                    '<text x="' + (width - margin.right) + '" y="' + (height - 6) + '" text-anchor="end" font-size="11" fill="#6c757d">' + escapeHtml(last) + '</text>';

                memorySeries.forEach(s => {
                    const points = samples.map((sample, i) => x(i).toFixed(1) + ',' + y(sample[s.key]).toFixed(1)).join(' ');
                    svg += '<polyline fill="none" stroke="' + s.color + '" stroke-width="2" points="' + points + '" />';
                });

                // Transparent hit targets give a native tooltip listing every series for each sample.
                const slot = plotWidth / (samples.length - 1);

                samples.forEach((sample, i) => {
                    const tip = new Date(sample.sampledAtUtc).toLocaleTimeString() + '\n' +
                        memorySeries.map(s => s.label + ': ' + formatBytes(sample[s.key])).join('\n');
                    svg += '<rect x="' + (x(i) - slot / 2).toFixed(1) + '" y="' + margin.top + '" width="' + slot.toFixed(1) + '" height="' + plotHeight + '" fill="transparent"><title>' + escapeHtml(tip) + '</title></rect>';
                });

                svg += '</svg>';
                memoryChart.innerHTML = svg;
            }

            function updateCountdowns() {
                document.querySelectorAll('[data-countdown]').forEach(el => {
                    const target = new Date(el.getAttribute('data-countdown'));
                    const diffMs = target.getTime() - Date.now();

                    if (diffMs <= 0) {
                        el.textContent = 'Any moment';
                        return;
                    }

                    const seconds = Math.floor(diffMs / 1000);
                    const minutes = Math.floor(seconds / 60);
                    const remainder = seconds % 60;
                    el.textContent = minutes + 'm ' + remainder + 's';
                });
            }

            setInterval(updateCountdowns, 1000);
            refresh();
            setInterval(refresh, 1000);
        })();
    </script>
}
