@{
ViewData["Title"] = "Configuration";
}
<div class="mb-4">
<h1 class="mb-1">Configuration</h1>
<p class="text-muted mb-0">Manage TLinkProxy settings. Select an option to get started.</p>
</div>
<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
<div class="col">
<div class="card h-100 shadow-sm">
<div class="card-body d-flex flex-column">
<h5 class="card-title">Model Configuration</h5>
<p class="card-text text-muted flex-grow-1">Add, edit and manage AI model backends, aliases, routing and health settings.</p>
<a class="btn btn-primary align-self-start" asp-action="ModelConfiguration">Configure Models</a>
</div>
</div>
</div>
<div class="col">
<div class="card h-100 shadow-sm">
<div class="card-body d-flex flex-column">
<h5 class="card-title">Visual Studio Settings</h5>
<p class="card-text text-muted flex-grow-1">Enable prompt trimming and configure blocks, text patterns, regex patterns and Copilot instructions for Visual Studio prompts.</p>
<a class="btn btn-primary align-self-start" asp-action="VisualStudio">Configure Visual Studio</a>
</div>
</div>
</div>
<div class="col">
<div class="card h-100 shadow-sm text-muted border-secondary">
<div class="card-body d-flex flex-column">
<h5 class="card-title">More Options</h5>
<p class="card-text flex-grow-1">Additional configuration options are coming soon.</p>
<span class="badge text-bg-secondary align-self-start">Coming soon</span>
</div>
</div>
</div>
</div>