<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Views\Configuration\**" />
		<Content Remove="Views\Configuration\**" />
		<EmbeddedResource Remove="Views\Configuration\**" />
		<None Remove="Views\Configuration\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AspNetCore.PluginManager" Version="5.11.0" />
		<PackageReference Include="CleanCodeAnalyzer" Version="1.1.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="MemoryCache.Plugin" Version="5.10.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
		<PackageReference Include="PluginManager" Version="5.11.0" />
		<PackageReference Include="SharedPluginFeatures" Version="5.11.0" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="jQuery" Version="3.7.1" />
		<PackageReference Include="SC.Shared.Library.Core" Version="$(SharedVer)" />
		<PackageReference Include="ApplicationSettings" Version="2.3.0" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="9.0.0" />
		<PackageReference Include="SC.Shared.Library.Core.Windows" Version="$(SharedWinVer)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SimpleDB" Version="6.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TLinkProxy.Abstractions\TLinkProxy.Abstractions.csproj" />
		<ProjectReference Include="..\TLinkProxy.Clients\TLinkProxy.Clients.csproj" />
		<ProjectReference Include="..\TLinkProxy.Configuration\TLinkProxy.Configuration.csproj" />
		<ProjectReference Include="..\TLinkProxy.Db\TLinkProxy.Db.csproj" />
		<ProjectReference Include="..\TLinkProxy.Processes\TLinkProxy.Processes.csproj" />
		<ProjectReference Include="..\TLinkProxy.Proxy\TLinkProxy.Proxy.csproj" />
		<ProjectReference Include="..\TLinkProxy.Services\TLinkProxy.Services.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="wwwroot\" />
	</ItemGroup>

</Project>
