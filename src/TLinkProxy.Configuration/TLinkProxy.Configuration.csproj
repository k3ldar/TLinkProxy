<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
	  <Content Remove="Views\Configuration\Edit.cshtml" />
	  <Content Remove="Views\Configuration\Index.cshtml" />
	  <Content Remove="Views\Configuration\ModelConfiguration.cshtml" />
	  <Content Remove="Views\Configuration\VisualStudio.cshtml" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Views\Configuration\Edit.cshtml" />
	  <EmbeddedResource Include="Views\Configuration\Index.cshtml" />
	  <EmbeddedResource Include="Views\Configuration\ModelConfiguration.cshtml" />
	  <EmbeddedResource Include="Views\Configuration\VisualStudio.cshtml" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CleanCodeAnalyzer" Version="1.1.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="MemoryCache.Plugin" Version="5.10.0" />
		<PackageReference Include="PluginManager" Version="5.11.0" />
		<PackageReference Include="SharedPluginFeatures" Version="5.11.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\TLinkProxy.Abstractions\TLinkProxy.Abstractions.csproj" />
	  <ProjectReference Include="..\TLinkProxy.Base\TLinkProxy.Base.csproj" />
	  <ProjectReference Include="..\TLinkProxy.Clients\TLinkProxy.Clients.csproj" />
	  <ProjectReference Include="..\TLinkProxy.Processes\TLinkProxy.Processes.csproj" />
	</ItemGroup>
	
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>TLinkProxy.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
